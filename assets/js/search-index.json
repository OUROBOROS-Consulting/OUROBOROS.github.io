---
layout: null
permalink: /assets/js/search-index.json
---
[
{%- assign first_item = true -%}
{%- for collection in site.collections -%}
  {%- for doc in collection.docs -%}
    {%- if doc.title -%}
      {%- unless first_item -%},{%- endunless -%}
      {"title":{{ doc.title | jsonify }},"url":{{ doc.url | relative_url | jsonify }},"description":{{ doc.description | default: doc.excerpt | default: "" | strip_html | truncatewords: 30 | strip_newlines | jsonify }},"type":{{ doc.collection | jsonify }}}
      {%- assign first_item = false -%}
    {%- endif -%}
  {%- endfor -%}
{%- endfor -%}
{%- for page in site.pages -%}
  {%- if page.title -%}
    {%- unless first_item -%},{%- endunless -%}
    {"title":{{ page.title | jsonify }},"url":{{ page.url | relative_url | jsonify }},"description":{{ page.description | default: "" | strip_html | truncatewords: 30 | strip_newlines | jsonify }},"type":"page"}
    {%- assign first_item = false -%}
  {%- endif -%}
{%- endfor -%}
]
